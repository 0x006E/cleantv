<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101419"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingEnd="48dp"
    android:paddingTop="32dp"
    android:paddingBottom="32dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/setup_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Set-Top Box &amp; Remote Setup"
                android:textColor="#FFFFFFFF"
                android:textSize="26sp"
                android:fontFamily="@font/outfit_medium" />

            <TextView
                android:id="@+id/setup_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Search your DTH / Cable operator, then pair your remote control"
                android:textColor="#A1A1AA"
                android:textSize="13sp"
                android:fontFamily="@font/outfit" />
        </LinearLayout>

        <!-- Segmented Mode Switcher: 1. Select Provider, 2. Pair Remote -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_mode_provider"
                style="@style/TopButtonBase"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center"
                android:text="Select Provider"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btn_mode_pair"
                style="@style/TopButtonBase"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center"
                android:text="Pair Remote"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Content 1: Provider Selection & Search -->
    <LinearLayout
        android:id="@+id/panel_provider"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="20dp"
        android:orientation="vertical">

        <!-- Search Input -->
        <EditText
            android:id="@+id/search_provider_input"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/search_input_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:hint="Type provider name (e.g. Kerala Vision, Tata Play, Airtel...)"
            android:textColorHint="#66FFFFFF"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:fontFamily="@font/outfit"
            android:singleLine="true"
            android:imeOptions="actionSearch" />

        <!-- Providers List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/providers_recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp" />
    </LinearLayout>

    <!-- Content 2: Remote Pairing Wizard -->
    <LinearLayout
        android:id="@+id/panel_pair"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="20dp"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Card with current candidate remote -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_panel"
            android:padding="20dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/wizard_provider_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kerala Vision Digital Network"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp"
                android:fontFamily="@font/outfit_medium" />

            <TextView
                android:id="@+id/wizard_remote_candidate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Remote Model 1 of 7 (Remote #43, 32-bit NEC)"
                android:textColor="#38BDF8"
                android:textSize="14sp"
                android:fontFamily="@font/outfit" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Point your USB IR blaster at the Set-Top Box. Click 'Test Power' to verify if your STB turns ON/OFF."
                android:textColor="#D4D4D8"
                android:textSize="13sp"
                android:fontFamily="@font/outfit" />

            <!-- Test signal feedback line -->
            <TextView
                android:id="@+id/wizard_feedback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Ready to test"
                android:textColor="#10B981"
                android:textSize="13sp"
                android:fontFamily="@font/outfit_medium" />

            <!-- Test action buttons row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_test_power"
                    style="@style/TopButtonBase"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:gravity="center"
                    android:text="Test Power"
                    android:textColor="#EF4444"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btn_test_vol_up"
                    style="@style/TopButtonBase"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:gravity="center"
                    android:text="Test Vol+"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btn_test_ch_up"
                    style="@style/TopButtonBase"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:gravity="center"
                    android:text="Test Ch+"
                    android:textSize="13sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/btn_next_remote"
                    style="@style/TopButtonBase"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="10dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:gravity="center"
                    android:text="Next Model"
                    android:textColor="#38BDF8"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btn_pair_confirm"
                    style="@style/TopButtonBase"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:gravity="center"
                    android:text="Pair This Remote"
                    android:textColor="#10B981"
                    android:textStyle="bold"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
