<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="28dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Elevated Material Card (Casts natural drop-shadow on translationZ, NO borders) -->
    <FrameLayout
        android:id="@+id/card"
        android:layout_width="180dp"
        android:layout_height="101dp"
        android:layout_gravity="center_horizontal|top"
        android:background="@drawable/tile_bg"
        android:outlineProvider="background"
        android:clipToOutline="true"
        android:focusable="true"
        android:clickable="true">

        <!-- 1. Full-bleed banner (for apps with 16:9 banners) -->
        <ImageView
            android:id="@+id/banner_fill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="@null" />

        <!-- 2. Centered Logo / Icon (for channels, inputs) -->
        <ImageView
            android:id="@+id/artwork_center"
            android:layout_width="92dp"
            android:layout_height="54dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="@null" />

        <!-- 3. Icon for non-banner apps (48x48dp, center-top) -->
        <ImageView
            android:id="@+id/artwork_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:layout_marginBottom="14dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="@null" />

        <!-- 4. Inside label for icon-only cards when unfocused -->
        <TextView
            android:id="@+id/card_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:fontFamily="@font/outfit"
            android:visibility="gone" />

        <!-- 5. Fallback Centered Text (when logo/icon is unavailable) -->
        <TextView
            android:id="@+id/text_fallback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:fontFamily="@font/outfit_medium"
            android:visibility="gone" />

        <!-- 6. Top-End Subtle Glass Badge (LCN number or status) -->
        <TextView
            android:id="@+id/badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/lcn_badge_bg"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="#D4D4D8"
            android:textSize="11sp"
            android:fontFamily="@font/outfit_medium"
            android:visibility="gone" />
    </FrameLayout>

    <!-- TVOS-Style Title Underneath (Animated on focus across ALL rails) -->
    <TextView
        android:id="@+id/title"
        android:layout_width="180dp"
        android:layout_height="22dp"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="108dp"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="end"
        android:alpha="0"
        android:translationY="-6dp"
        android:textColor="#F2FFFFFF"
        android:textSize="14sp"
        android:fontFamily="@font/outfit_medium"
        android:letterSpacing="0.02" />
</FrameLayout>

