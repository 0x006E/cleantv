<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="28dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/channel_card"
        android:layout_width="180dp"
        android:layout_height="101dp"
        android:layout_gravity="center_horizontal|top"
        android:background="@drawable/tile_bg"
        android:focusable="true"
        android:clickable="true">

        <!-- LCN Badge in corner -->
        <TextView
            android:id="@+id/channel_lcn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/lcn_badge_bg"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="103"
            android:textColor="#D4D4D8"
            android:textSize="11sp"
            android:fontFamily="@font/outfit_medium" />

        <TextView
            android:id="@+id/channel_genre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/genre_badge_bg"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="SPORTS"
            android:textColor="#A1A1AA"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:textAllCaps="true"
            android:visibility="gone" />

        <!-- Large, beautiful Channel Logo in Center -->
        <ImageView
            android:id="@+id/channel_logo"
            android:layout_width="92dp"
            android:layout_height="54dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <!-- Fallback text inside card if logo is missing -->
        <TextView
            android:id="@+id/channel_logo_fallback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:fontFamily="@font/outfit_medium"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Unified TVOS-Style Title Underneath (Animated on focus, identical to Apps rail) -->
    <TextView
        android:id="@+id/channel_name"
        android:layout_width="180dp"
        android:layout_height="22dp"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="108dp"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:fontFamily="@font/outfit"
        android:visibility="invisible" />
</FrameLayout>
