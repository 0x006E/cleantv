<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101419"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingEnd="72dp"
        android:paddingTop="38dp"
        android:paddingBottom="38dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/launcher_settings"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/columns_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/columns4" style="@style/SettingsColumnChoice" android:text="4" />
            <TextView android:id="@+id/columns5" style="@style/SettingsColumnChoice" android:text="5" />
            <TextView android:id="@+id/columns6" style="@style/SettingsColumnChoice" android:text="6" />
            <TextView android:id="@+id/columns7" style="@style/SettingsColumnChoice" android:text="7" />
        </LinearLayout>

        <TextView
            android:id="@+id/animationsChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="28dp" />

        <TextView
            android:id="@+id/advancedChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/advanced_effects_warning"
            android:textColor="#FFACB8C1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/followThemeChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="18dp"
            android:text="@string/follow_theme" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/follow_theme_hint"
            android:textColor="#FFACB8C1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/defaultHomeChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="28dp"
            android:text="@string/home_settings" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/home_settings_help"
            android:textColor="#FFACB8C1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvSettingsChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="18dp"
            android:text="@string/tv_settings" />

        <!-- STB & Universal LCN Settings -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Set-Top Box &amp; AV1 Live Channels"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/stbProviderChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/pairRemoteChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:text="Pair STB Remote (Interactive Wizard)" />

        <TextView
            android:id="@+id/testIrChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:text="Quick Test (Send POWER)" />

        <TextView
            android:id="@+id/avInputChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:text="Input Source: AV1 (HW3)" />

        <TextView
            android:id="@+id/resetChannelsChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:text="Reset Custom Channel Numbers &amp; Favourites" />

        <!-- Mobile Companion App & Security -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Mobile Companion App (Secure Pairing)"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/companionPairingChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:text="Pair Mobile Companion App" />

        <TextView
            android:id="@+id/forgetCompanionDevicesChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:text="Forget Paired Mobile Devices" />

        <!-- Settings Backup & Restore -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Backup &amp; Restore"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/backupSettingsChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:text="Export Settings to File (/sdcard/Download)" />

        <TextView
            android:id="@+id/restoreSettingsChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:text="Import Settings from File (/sdcard/Download)" />
    </LinearLayout>
</ScrollView>
