<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:gravity="center_vertical"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Left Rail Section Header (Classic Android TV Rail Badge) -->
    <LinearLayout
        android:id="@+id/rail_header"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingEnd="12dp"
        android:focusable="false">

        <FrameLayout
            android:id="@+id/rail_badge"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/remote_circle_btn_bg">

            <ImageView
                android:id="@+id/rail_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:tint="#FFFFFFFF"
                android:src="@drawable/ic_apps"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:id="@+id/rail_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Apps"
            android:textColor="#A1A1AA"
            android:textSize="12sp"
            android:fontFamily="@font/outfit_medium"
            android:letterSpacing="0.05"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Horizontal Row Cards -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rail_recycler"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:descendantFocusability="afterDescendants" />
</LinearLayout>

