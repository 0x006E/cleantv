<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="10dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Section Header (Classic Google Android TV Section Header above row) -->
    <LinearLayout
        android:id="@+id/rail_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingBottom="4dp"
        android:focusable="false">

        <ImageView
            android:id="@+id/rail_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:tint="#A1A1AA"
            android:src="@drawable/ic_apps"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/rail_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Favourite apps"
            android:textColor="#E4E4E7"
            android:textSize="14sp"
            android:fontFamily="@font/outfit_medium"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Horizontal Row Cards -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rail_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="40dp"
        android:paddingEnd="48dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:overScrollMode="never" />
</LinearLayout>
