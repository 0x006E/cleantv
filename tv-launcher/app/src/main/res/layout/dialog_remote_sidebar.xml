<?xml version="1.0" encoding="utf-8"?>
<!-- Translucent sidebar dialog for AV1 STB channels and remote control operations.
     Styled 100% following cleanyourtv's Apple TV / glass_panel convention. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sidebar_backdrop"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:descendantFocusability="afterDescendants"
    android:background="#4D000000">

    <LinearLayout
        android:id="@+id/sidebar_panel"
        android:layout_width="380dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_margin="16dp"
        android:orientation="vertical"
        android:background="@drawable/glass_panel"
        android:padding="20dp"
        android:clickable="true"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:descendantFocusability="afterDescendants"
        android:elevation="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/remote_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AV1 REMOTE"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp"
                    android:fontFamily="@font/outfit_medium"
                    android:letterSpacing="-0.01" />

                <TextView
                    android:id="@+id/remote_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Kerala Vision (AV1)"
                    android:textColor="#99FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_close_remote"
                style="@style/TopButtonBase"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:gravity="center"
                android:text="✕"
                android:textSize="14sp"
                android:nextFocusLeft="@+id/tab_pairing"
                android:nextFocusDown="@+id/tab_pairing" />
        </LinearLayout>

        <!-- Segmented Tab Switcher: Channels vs Remote vs Pairing -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tab_channels"
                style="@style/TopButtonBase"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="4dp"
                android:gravity="center"
                android:text="Channels"
                android:textSize="13sp"
                android:nextFocusRight="@+id/tab_remote"
                android:nextFocusDown="@+id/sidebar_channels_list" />

            <TextView
                android:id="@+id/tab_remote"
                style="@style/TopButtonBase"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="4dp"
                android:gravity="center"
                android:text="Remote"
                android:textSize="13sp"
                android:nextFocusLeft="@+id/tab_channels"
                android:nextFocusRight="@+id/tab_pairing"
                android:nextFocusDown="@+id/btn_power" />

            <TextView
                android:id="@+id/tab_pairing"
                style="@style/TopButtonBase"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="0dp"
                android:gravity="center"
                android:text="Pairing"
                android:textSize="13sp"
                android:nextFocusLeft="@+id/tab_remote"
                android:nextFocusRight="@+id/btn_close_remote"
                android:nextFocusDown="@+id/btn_sidebar_test_chup" />
        </LinearLayout>

        <!-- Container 1: Channels List -->
        <FrameLayout
            android:id="@+id/channels_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/sidebar_channels_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:scrollbars="none"
                android:overScrollMode="never" />
        </FrameLayout>

        <!-- Container 2: Tactile Remote Keypad -->
        <ScrollView
            android:id="@+id/remote_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="8dp">

                <!-- Power & Mute -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:id="@+id/btn_power"
                        style="@style/TopButtonBase"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginStart="0dp"
                        android:layout_marginEnd="6dp"
                        android:gravity="center"
                        android:text="Power"
                        android:textColor="#EF4444"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/btn_mute"
                        style="@style/TopButtonBase"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:gravity="center"
                        android:text="Mute"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- D-Pad Navigation Ring -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:id="@+id/btn_dpad_up"
                        style="@style/TopButtonBase"
                        android:layout_width="72dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="0dp"
                        android:gravity="center"
                        android:text="▲"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:id="@+id/btn_dpad_left"
                            style="@style/TopButtonBase"
                            android:layout_width="72dp"
                            android:layout_height="42dp"
                            android:layout_marginStart="0dp"
                            android:layout_marginEnd="8dp"
                            android:gravity="center"
                            android:text="◀"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/btn_dpad_ok"
                            style="@style/TopButtonBase"
                            android:layout_width="84dp"
                            android:layout_height="42dp"
                            android:layout_marginStart="0dp"
                            android:gravity="center"
                            android:text="OK"
                            android:textColor="#FFFFFFFF"
                            android:textSize="15sp"
                            android:fontFamily="@font/outfit_medium" />

                        <TextView
                            android:id="@+id/btn_dpad_right"
                            style="@style/TopButtonBase"
                            android:layout_width="72dp"
                            android:layout_height="42dp"
                            android:layout_marginStart="8dp"
                            android:gravity="center"
                            android:text="▶"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btn_dpad_down"
                        style="@style/TopButtonBase"
                        android:layout_width="72dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="0dp"
                        android:gravity="center"
                        android:text="▼"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- Rockers: Vol +/-, Ch +/- and Recall -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:id="@+id/btn_vol_up"
                        style="@style/TopButtonBase"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginStart="0dp"
                        android:gravity="center"
                        android:text="VOL +"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btn_recall"
                        style="@style/TopButtonBase"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:gravity="center"
                        android:text="RECALL"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/btn_ch_up"
                        style="@style/TopButtonBase"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginStart="0dp"
                        android:gravity="center"
                        android:text="CH +"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:id="@+id/btn_vol_down"
                        style="@style/TopButtonBase"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginStart="0dp"
                        android:gravity="center"
                        android:text="VOL −"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btn_menu"
                        style="@style/TopButtonBase"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:gravity="center"
                        android:text="MENU"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/btn_ch_down"
                        style="@style/TopButtonBase"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginStart="0dp"
                        android:gravity="center"
                        android:text="CH −"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Numeric Keypad 3x4 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">
                        <TextView android:id="@+id/btn_num_1" style="@style/TopButtonBase" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:layout_marginStart="0dp" android:gravity="center" android:text="1" />
                        <TextView android:id="@+id/btn_num_2" style="@style/TopButtonBase" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:gravity="center" android:text="2" />
                        <TextView android:id="@+id/btn_num_3" style="@style/TopButtonBase" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:layout_marginStart="0dp" android:gravity="center" android:text="3" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">
                        <TextView android:id="@+id/btn_num_4" style="@style/TopButtonBase" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:layout_marginStart="0dp" android:gravity="center" android:text="4" />
                        <TextView android:id="@+id/btn_num_5" style="@style/TopButtonBase" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:gravity="center" android:text="5" />
                        <TextView android:id="@+id/btn_num_6" style="@style/TopButtonBase" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:layout_marginStart="0dp" android:gravity="center" android:text="6" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">
                        <TextView android:id="@+id/btn_num_7" style="@style/TopButtonBase" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:layout_marginStart="0dp" android:gravity="center" android:text="7" />
                        <TextView android:id="@+id/btn_num_8" style="@style/TopButtonBase" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:gravity="center" android:text="8" />
                        <TextView android:id="@+id/btn_num_9" style="@style/TopButtonBase" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:layout_marginStart="0dp" android:gravity="center" android:text="9" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView android:id="@+id/btn_exit" style="@style/TopButtonBase" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:layout_marginStart="0dp" android:gravity="center" android:text="EXIT" android:textSize="11sp" />
                        <TextView android:id="@+id/btn_num_0" style="@style/TopButtonBase" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:gravity="center" android:text="0" />
                        <TextView android:id="@+id/btn_back" style="@style/TopButtonBase" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:layout_marginStart="0dp" android:gravity="center" android:text="BACK" android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Container 3: Live TV Interactive Remote Pairing -->
        <ScrollView
            android:id="@+id/pairing_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp">

                <TextView
                    android:id="@+id/sidebar_pairing_provider"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kerala Vision Digital Network"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:fontFamily="@font/outfit_medium" />

                <TextView
                    android:id="@+id/sidebar_pairing_model"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Candidate Model 1 of 7 (Remote #43)"
                    android:textColor="#38BDF8"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Watch your Live TV on the left while testing. Does the channel or volume change?"
                    android:textColor="#A1A1AA"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit" />

                <TextView
                    android:id="@+id/sidebar_pairing_feedback"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Ready to test candidate remote"
                    android:textColor="#10B981"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit_medium" />

                <!-- Test action buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_sidebar_test_chup"
                        style="@style/TopButtonBase"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginStart="0dp"
                        android:gravity="center"
                        android:text="Test CH +"
                        android:textSize="12sp"
                        android:nextFocusUp="@+id/tab_pairing"
                        android:nextFocusRight="@+id/btn_sidebar_test_chdown"
                        android:nextFocusDown="@+id/btn_sidebar_test_power" />

                    <TextView
                        android:id="@+id/btn_sidebar_test_chdown"
                        style="@style/TopButtonBase"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:gravity="center"
                        android:text="Test CH −"
                        android:textSize="12sp"
                        android:nextFocusUp="@+id/tab_pairing"
                        android:nextFocusLeft="@+id/btn_sidebar_test_chup"
                        android:nextFocusDown="@+id/btn_sidebar_test_volup" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_sidebar_test_power"
                        style="@style/TopButtonBase"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginStart="0dp"
                        android:gravity="center"
                        android:text="Test Power"
                        android:textColor="#EF4444"
                        android:textSize="12sp"
                        android:nextFocusUp="@+id/btn_sidebar_test_chup"
                        android:nextFocusRight="@+id/btn_sidebar_test_volup"
                        android:nextFocusDown="@+id/btn_sidebar_prev_model" />

                    <TextView
                        android:id="@+id/btn_sidebar_test_volup"
                        style="@style/TopButtonBase"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:gravity="center"
                        android:text="Test Vol+"
                        android:textSize="12sp"
                        android:nextFocusUp="@+id/btn_sidebar_test_chdown"
                        android:nextFocusLeft="@+id/btn_sidebar_test_power"
                        android:nextFocusDown="@+id/btn_sidebar_next_model" />
                </LinearLayout>

                <!-- Model selection navigation row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_sidebar_prev_model"
                        style="@style/TopButtonBase"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginStart="0dp"
                        android:gravity="center"
                        android:text="◀ Prev Model"
                        android:textSize="12sp"
                        android:nextFocusUp="@+id/btn_sidebar_test_power"
                        android:nextFocusRight="@+id/btn_sidebar_next_model"
                        android:nextFocusDown="@+id/btn_sidebar_pair_confirm" />

                    <TextView
                        android:id="@+id/btn_sidebar_next_model"
                        style="@style/TopButtonBase"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:gravity="center"
                        android:text="Next Model ▶"
                        android:textColor="#38BDF8"
                        android:textSize="12sp"
                        android:nextFocusUp="@+id/btn_sidebar_test_volup"
                        android:nextFocusLeft="@+id/btn_sidebar_prev_model"
                        android:nextFocusDown="@+id/btn_sidebar_pair_confirm" />
                </LinearLayout>

                <!-- Confirm pairing button -->
                <TextView
                    android:id="@+id/btn_sidebar_pair_confirm"
                    style="@style/TopButtonBase"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="Pair This Remote"
                    android:textColor="#10B981"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:nextFocusUp="@+id/btn_sidebar_prev_model"
                    android:nextFocusDown="@+id/btn_sidebar_change_provider" />

                <!-- Change Provider button -->
                <TextView
                    android:id="@+id/btn_sidebar_change_provider"
                    style="@style/TopButtonBase"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Change Provider Search"
                    android:textColor="#A1A1AA"
                    android:textSize="12sp"
                    android:nextFocusUp="@+id/btn_sidebar_pair_confirm" />
            </LinearLayout>
        </ScrollView>

        <!-- Status line -->
        <TextView
            android:id="@+id/remote_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="#80FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/outfit"
            android:singleLine="true" />

        <TextView
            android:id="@+id/btn_pair_remote_sidebar"
            style="@style/TopButtonBase"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Pair Remote / Change Provider"
            android:textColor="#F2FFFFFF"
            android:textSize="13sp"
            android:fontFamily="@font/outfit_medium" />
    </LinearLayout>
</FrameLayout>
